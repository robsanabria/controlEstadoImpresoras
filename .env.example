# ==========================================================================
#  Verificación de Lectores — variables de entorno
#  Copiar a .env. El .env NO se commitea.
# ==========================================================================

PORT=3008
# production | test | dev  → dispara la cinta de entorno en la barra.
APP_ENV=dev

# --- Base de datos compartida (controletiquetas / controletiquetas-test) -----
# En local apuntar SIEMPRE a la base de TEST.
# Las tablas NO se crean al arrancar: correr db/migrations/001-*.sql una vez.
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASS=
DB_PORT=1433
# El cifrado va prendido por defecto. Contra SQL Express local, DB_ENCRYPT=false.
DB_ENCRYPT=true
# Sólo para SQL Express local con certificado autofirmado.
DB_TRUST_CERT=false

# --- Modo demo (sin base) ----------------------------------------------------
# Arranca sin base y guarda las verificaciones EN MEMORIA (se pierden al reiniciar).
# Sirve para mostrarles el formulario a los encargados antes de tener App Service
# y base. En Azure NO se carga esta variable.
MODO_DEMO=false

# --- Desarrollo local (NUNCA en producción) ----------------------------------
# Simula un login sin Easy Auth. Sin este flag y sin la cabecera de Easy Auth,
# la API devuelve 401. En Azure estas dos NO deben existir.
ALLOW_DEV_LOGIN=false
DEV_EMAIL=

# --- Autorización ------------------------------------------------------------
# Exigir rol de la app 'lectores' en el padrón (acceso.Permisos) para operar.
# Dejar en false hasta cargar la app 'lectores' en el padrón; después true.
# Con false, cualquier usuario autenticado puede cargar y firmar.
LECTORES_REQUIRE_PERMISSION=false

# Permitir que el mismo usuario que cargó la verificación la firme.
# En producción va en false: el conforme lo da el encargado, no Sistemas.
# Poner true sólo para probar el circuito completo en local con un solo usuario.
PERMITIR_AUTOFIRMA=false

# --- CORS --------------------------------------------------------------------
# Front y API comparten origen: en producción esto queda VACÍO.
CORS_ORIGINS=
